# 数据库：本地开发用 SQLite；部署到 Postgres 时改成连接串
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 登录会话 cookie 的签名密钥；部署到公网务必改成一长串随机字符
APP_SECRET="head-metting-local-secret"

# 后台管理口令：设了之后 /admin 须先输口令才能进；留空则不上锁（本地开发照旧直入）
ADMIN_PASSWORD=""

# 登录页是否罗列已有账号名：true 则隐藏，访客直接进「另立新账号」模式
HIDE_ACCOUNT_LIST=""

# —— 平台共用模型（可选，部署给他人体验时强烈建议设置）——
# 设了之后，新注册的访客无需自己配密钥即可直接开辩；
# 访客一旦在后台填了自己的，便以他自己的为准。
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""
LLM_TEMPERATURE="0.9"
LLM_MAX_TOKENS="1200"
LLM_TIMEOUT_MS="120000"
